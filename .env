# HelpDesk — Environment Configuration
# NE JAMAIS committer ce fichier dans Git (ajouter .env au .gitignore)

# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=reclamations
DB_USERNAME=root
DB_PASSWORD=

# Application
APP_NAME=HelpDesk
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Session
SESSION_LIFETIME=120

# Upload
MAX_UPLOAD_SIZE_MB=5
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,docx

# Mailer (à remplir quand PHPMailer sera intégré)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"